<UserControl x:Class="ZwcadBatchPlot.DirectorySettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei" FontSize="12">
    <UserControl.Resources>
        <Style x:Key="CellButton" TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ParamInput" TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>
        <Style x:Key="EditableCellBox" TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCustom}" Value="False">
                    <Setter Property="IsReadOnly" Value="True"/>
                    <Setter Property="Background" Value="#FFF4F4F4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 目录字体及绘制相关设置 -->
        <GroupBox Grid.Row="0" Header="目录字体及绘制相关设置" Margin="0,0,0,6">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,6,0">
                    <TextBlock Text="颜色索引" Margin="0,0,0,3"/>
                    <ComboBox x:Name="ColorCombo" Height="24">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="12" BorderBrush="#FF666666" BorderThickness="1"
                                            Background="{Binding Brush}" Margin="0,1,6,1"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="点选目录文字" Style="{StaticResource CellButton}" HorizontalAlignment="Left"
                            Margin="0,4,0,0" ToolTip="在当前活动图纸中点选文字，自动读取颜色、字高、宽度因子、文字样式和图层。"
                            Click="OnPickTextAppearanceClick"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,6,0">
                    <TextBlock Text="文字高度" Margin="0,0,0,3"/>
                    <TextBox x:Name="TextHeightBox" Style="{StaticResource ParamInput}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,6,0">
                    <TextBlock Text="宽度因子" Margin="0,0,0,3"/>
                    <TextBox x:Name="WidthFactorBox" Style="{StaticResource ParamInput}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Grid.Row="0" Margin="0,0,6,0">
                    <TextBlock Text="文字样式" Margin="0,0,0,3"/>
                    <ComboBox x:Name="StyleCombo" Height="24"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Grid.Row="0" Margin="0,0,6,0">
                    <TextBlock Text="图层名称" Margin="0,0,0,3"/>
                    <TextBox x:Name="LayerBox" Style="{StaticResource ParamInput}"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Grid.Row="0">
                    <TextBlock Text="目录行高" Margin="0,0,0,3"/>
                    <TextBox x:Name="RowHeightBox" Style="{StaticResource ParamInput}"/>
                    <Button Content="图中交互" Style="{StaticResource CellButton}" HorizontalAlignment="Left"
                            Margin="0,4,0,0" ToolTip="在 CAD 图纸中框选两行目录以量取行高。"
                            Click="OnPickRowHeightClick"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.ColumnSpan="6" Grid.Row="2" Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <CheckBox x:Name="DrawHeaderCheck" Content="绘制目录表头" Margin="0,0,24,0" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="DrawGridLinesCheck" Content="绘制目录框线" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 目录内容设置 -->
        <GroupBox Grid.Row="1" Header="目录内容设置">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="ColumnGrid" Grid.Row="0"
                          ItemsSource="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserResizeRows="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                          SelectionUnit="FullRow" SelectionMode="Single" EnableRowVirtualization="False"
                          HeadersVisibility="Column" GridLinesVisibility="All"
                          RowHeight="34" ColumnHeaderHeight="30"
                          Background="White" BorderBrush="#FFDCDCDC" BorderThickness="1"
                          HorizontalGridLinesBrush="#FFE3E3E3" VerticalGridLinesBrush="#FFE3E3E3"
                          AlternatingRowBackground="#FFFAFAFA"
                          HorizontalScrollBarVisibility="Auto"
                          ButtonBase.Click="OnGridButtonClick"
                          Thumb.DragStarted="OnRowDragStarted"
                          Thumb.DragDelta="OnRowDragDelta"
                          Thumb.DragCompleted="OnRowDragCompleted"
                          ContextMenuOpening="OnContextMenuOpening">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="向上插入自定义行" Click="OnInsertCustomAbove"/>
                            <MenuItem Header="向下插入自定义行" Click="OnInsertCustomBelow"/>
                            <Separator/>
                            <MenuItem x:Name="DeleteMenuItem" Header="删除自定义行" Click="OnDeleteCustomRow"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <!-- 拖拽手柄：Thumb 拖拽整行重排 -->
                        <DataGridTemplateColumn Width="30" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Thumb Cursor="SizeNS" ToolTip="拖动调整列顺序">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent">
                                                    <TextBlock Text="⋮⋮" FontSize="11" Foreground="#FF888888"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="是否启用" Width="60" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="文字居中" Width="60" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Centered, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="目录列名" Width="*" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Header, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EditableCellBox}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="目录列宽" Width="74" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EditableCellBox}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="设置列宽" Width="76" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="图中交互" Tag="PickWidth" Style="{StaticResource CellButton}"
                                            ToolTip="关闭设置窗口后回到 CAD 框选两列目录以量取该列宽度。"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="上移" Width="48" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="上移" Tag="MoveUp" Style="{StaticResource CellButton}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="下移" Width="48" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="下移" Tag="MoveDown" Style="{StaticResource CellButton}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="自定义内容" Width="110" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding CustomText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EditableCellBox}"
                                             ToolTip="仅自定义行可编辑；生成目录时该列所有行填充此内容。"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Text="顺序预览（按实际列宽、行高和字高等比例缩放）"
                           Foreground="#FF696969" FontSize="11" Margin="0,6,0,3"/>

                <Border x:Name="PreviewHost" Grid.Row="2" Height="76" Background="White"
                        BorderBrush="#FFDCDCDC" BorderThickness="1"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
